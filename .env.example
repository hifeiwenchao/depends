# Because README validation sources .env as POSIX shell, generate every password from A-Z, a-z, 0-9, dot, underscore, tilde, and hyphen only.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=dev
MYSQL_PASSWORD=
POSTGRES_USER=dev
POSTGRES_PASSWORD=
POSTGRES_DB=dev
# Oracle SYS/SYSTEM administrator password and the application schema in FREEPDB1.
ORACLE_PASSWORD=
ORACLE_APP_USER=dev
ORACLE_APP_PASSWORD=
# Redis ACL credentials: use only A-Z, a-z, 0-9, dot, underscore, tilde, and hyphen.
REDIS_USERNAME=default
REDIS_PASSWORD=
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=
# RabbitMQ initialization user must not be guest; use a non-guest name such as dev.
RABBITMQ_DEFAULT_USER=dev
RABBITMQ_DEFAULT_PASS=
ELASTIC_PASSWORD=
TZ=Asia/Shanghai
